# LiveKit Cloud project credentials (same project as the web app).
# Note: the agent uses LIVEKIT_URL (no NEXT_PUBLIC_ prefix).
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_API_KEY
LIVEKIT_API_SECRET=YOUR_API_SECRET

# alexa360 (uChat) REST API — powers the default/Alexa360 persona's knowledge base.
# Create a token in alexa360 with "Manage Flow" + "Manage Team" scopes.
ALEXA360_API_BASE=https://app.alexa360.io/api
ALEXA360_API_KEY=
# Which alexa360 AI agent (by ai_agent_ns) to use when the room doesn't name one
# via ?agent=. Set to ALSALAM_AGENT_KEY below to default to the hospital persona
# instead. Leave both this and ALEXA360_API_KEY unset to fall back to a generic
# built-in persona.
ALEXA360_DEFAULT_AGENT_NS=

# Speech-to-text (LiveKit Inference). speechmatics/linden-1 with language=ar_en
# handles Arabic/English code-switching in one stream — Deepgram's "multi" mode
# does NOT include Arabic, so avoid that combination.
STT_MODEL=speechmatics/linden-1
STT_LANGUAGE=ar_en

# Text-to-speech (LiveKit Inference). cartesia/sonic-3 is multilingual and has
# been reliable in the eu LiveKit Cloud region; other providers (Fish Audio,
# Inworld) have returned REGION_RESTRICTED errors there — check your project's
# region before switching.
TTS_MODEL=cartesia/sonic-3
TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc

# HeyGen LiveAvatar video avatar, LITE mode (optional — leave LIVEAVATAR_API_KEY
# blank to run audio-only). LITE mode only renders video; our own STT/LLM/TTS
# above still drives what's said. Get a key at app.liveavatar.com -> Developers ->
# API Key, and an avatar_id from GET https://api.liveavatar.com/v1/avatars/public
# (header: X-Api-Key) or the Avatars tab in the dashboard.
AVATAR_ENABLED=false
LIVEAVATAR_API_KEY=
LIVEAVATAR_AVATAR_ID=
LIVEAVATAR_VIDEO_QUALITY=high

# Al Salam Hospital booking persona — a separate persona (own system prompt, no
# alexa360 knowledge base) that uses the hospital's own MCP server as tools.
# Selected via ?agent=<ALSALAM_AGENT_KEY>, or as the default via
# ALEXA360_DEFAULT_AGENT_NS above.
ALSALAM_AGENT_KEY=alsalam
ALSALAM_MCP_URL=https://salemmcp.alsalamhosp.com/mcp
# SERV_TYPE sent with every booking. The MCP server's submit_appointment
# requires it (calls without it are rejected before reaching the hospital)
# and nothing in the booking flow returns it -- confirm the value with the
# hospital.
ALSALAM_SERV_TYPE=1

# WhatsApp OTP delivery (Meta Graph API, direct). The hospital's own MCP
# `generate_otp` tool only creates the code -- it never sends it -- so the
# agent sends it itself via an approved AUTHENTICATION-category template
# ("otp", copy-code button) using the hospital's WABA. Get the access token
# and phone_number_id from Meta Business Manager (WhatsApp > API Setup).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=otp
WHATSAPP_OTP_TEMPLATE_LANG=en_US
WHATSAPP_API_VERSION=v21.0

# Calls are dispatched to workers by this name (must match the web app's AGENT_NAME).
AGENT_NAME=alsalam-concierge

# Default LLM (LiveKit Inference model id); each screen can override it in /admin.
LLM_MODEL=google/gemma-4-31b-it

# Hospital WhatsApp hotline used by the booking / reception hand-off cards.
HOSPITAL_WHATSAPP_HOTLINE=9651830003
HOSPITAL_WHATSAPP_HOTLINE_DISPLAY=+965 1830 003

# Newer hospital server: https://salemavatar.alsalamhosp.com/mcp requires a key
# (sent as X-API-Key). Leave empty for the older salemmcp server.
ALSALAM_MCP_API_KEY=
# Older server: always used for OTP, and as fallback when the newer server is refused access.
# Empty = no fallback.
ALSALAM_LEGACY_MCP_URL=https://salemmcp.alsalamhosp.com/mcp
# Newer REST API: https://salemavatar.alsalamhosp.com/api with its key (X-API-Key).
# ALSALAM_RAW_API_BASE=https://salemavatar.alsalamhosp.com/api
ALSALAM_RAW_API_KEY=
