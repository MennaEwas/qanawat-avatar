# Copy to deploy/.env (web container). The agent reads deploy/agent.env --
# copy agent/.env.example there and fill it in too.
# LiveKit -> Settings -> Keys.

NEXT_PUBLIC_LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=your-api-secret

# Calls go only to agent workers registered under this name (must match
# AGENT_NAME in agent.env).
AGENT_NAME=alsalam-concierge

# /admin panel login. Use a long random password; the session secret signs
# login cookies (any long random string, e.g. `openssl rand -hex 32`).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional: override branding / feature flags. Must be ONE line (flow YAML).
# Leave unset to use the built-in Qanawat defaults.
# NEXT_PUBLIC_APP_CONFIG={ title: 'Qanawat Concierge', description: '...', github_link: '', video_fit: 'cover', settings: { editable: true, theme_color: 'qanawat', chat: true, outputs: { audio: true, video: true }, inputs: { mic: true, camera: false } } }
