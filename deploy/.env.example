# Copy to deploy/.env and fill in from your LiveKit Cloud project.
# LiveKit Cloud -> Settings -> Keys.  https://cloud.livekit.io

NEXT_PUBLIC_LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=your-api-secret

# Optional: override branding / feature flags. Must be ONE line (flow YAML).
# Leave unset to use the built-in Qanawat defaults.
# NEXT_PUBLIC_APP_CONFIG={ title: 'Qanawat Concierge', description: '...', github_link: '', video_fit: 'cover', settings: { editable: true, theme_color: 'qanawat', chat: true, outputs: { audio: true, video: true }, inputs: { mic: true, camera: true } } }
