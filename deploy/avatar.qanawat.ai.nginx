# /etc/nginx/sites-available/avatar.qanawat.ai
# Reverse proxy for the Qanawat Concierge playground (Next.js on 127.0.0.1:3002).
#
# Install:
#   sudo cp avatar.qanawat.ai.nginx /etc/nginx/sites-available/avatar.qanawat.ai
#   sudo ln -s /etc/nginx/sites-available/avatar.qanawat.ai /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d avatar.qanawat.ai      # adds the TLS server block
#
# Note: real-time audio/video flows browser <-> LiveKit Cloud directly over WebRTC.
# nginx only proxies page loads and the POST /api/token call.

server {
    listen 80;
    listen [::]:80;
    server_name avatar.qanawat.ai;

    client_max_body_size 2m;

    location / {
        proxy_pass http://127.0.0.1:3002;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }
}

# Add once, in http{} scope (e.g. /etc/nginx/conf.d/ws_upgrade.conf) if not present:
#   map $http_upgrade $connection_upgrade { default upgrade; "" close; }
